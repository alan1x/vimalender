+				}
+			}
+			for d := base; !d.After(end); d = d.AddDate(0, 0, 1) {
+				if !d.Equal(base) && !matchesDate(ev, d) {
+					continue
+				}
+				appendMatch(d)
+			}
+			if len(m.searchMatches) > 2000 {
+				break outer
 			}
 		}
 	}
 
