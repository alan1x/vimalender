+// only the event's original week.
 func (m *Model) updateSearchMatches() {
 	m.searchMatches = nil
 	if m.searchQuery == "" {
 		return
 	}
 	query := strings.ToLower(m.searchQuery)
+	hits := func(ev Event) bool {
+		return strings.Contains(strings.ToLower(ev.Title), query) ||
